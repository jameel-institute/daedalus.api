{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
        "id": {
            "type": "string"
        },
        "values": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "metric": {
                        "type": "string",
                        "enum": [
                            "usd",
                            "life_years"
                        ]
                    },
                    "value": {
                        "type": "number"
                    }
                },
                "additionalProperties": false,
                "required": [
                    "metric",
                    "value"
                ]
            }
        },
        "children": {
            "type": "array",
            "items": {
                "$ref": "#"
            }
        }
    },
    "additionalProperties": false,
    "required": [
        "id",
        "values"
    ]
}
