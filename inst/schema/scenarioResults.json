{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "type": "object",
    "properties": {
        "runId": {
            "type": "string"
        },
        "parameters": {
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "costs": {
            "type": "array",
            "items": {
                "$ref": "scenarioCost.json"
            }
        },
        "capacities": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": { "type": "string" },
                    "value": { "type": "number" }
                },
                "additionalProperties": false,
                "required": ["id", "value"]
            }
        },
        "interventions": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": { "type":  "string" },
                    "start": { "type": "number" },
                    "end": { "type": "number" }
                },
                "additionalProperties": false,
                "required": [ "id", "start", "end" ]
            }
        },
        "time_series": {
            "type": "object",
            "additionalProperties": {
                "type": "array",
                "items": {
                    "type": "number"
                }
            }
        },
        "gdp": { "type": "number" },
        "average_vsl": { "type": "number" },
        "vsl_by_age": {
            "type": "object",
            "properties": {
                "vsl_pre_school": { "type": "number" },
                "vsl_school_age": { "type": "number" },
                "vsl_working_age": { "type": "number" },
                "vsl_retirement_age": { "type": "number" }
            },
            "additionalProperties": false,
            "required": ["vsl_pre_school", "vsl_school_age", "vsl_working_age", "vsl_retirement_age"]
        },
        "life_years_natural": {
            "type": "object",
            "properties": {
                "total": { "type": "number" },
                "by_age": {
                    "type": "object",
                    "properties": {
                        "life_years_natural_pre_school": { "type": "number" },
                        "life_years_natural_school_age": { "type": "number" },
                        "life_years_natural_working_age": { "type": "number" },
                        "life_years_natural_retirement_age": { "type": "number" }
                    },
                    "additionalProperties": false,
                    "required": ["life_years_natural_pre_school", "life_years_natural_school_age", "life_years_natural_working_age", "life_years_natural_retirement_age"]
                }
            },
            "additionalProperties": false,
            "required": ["total", "by_age"]
        }
    },
    "additionalProperties": false,
    "required": ["runId", "costs", "capacities", "interventions", "time_series", "gdp", "average_vsl", "vsl_by_age", "life_years_natural"]
}
