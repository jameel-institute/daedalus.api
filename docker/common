# -*-sh-*-
REGISTRY=ghcr.io
PACKAGE_ROOT=$(realpath $HERE/..)
PACKAGE_NAME=$(cat $PACKAGE_ROOT/DESCRIPTION | \
                      grep '^Package:' | sed 's/^.*: *//')
PACKAGE_ORG=jameel-institute
PACKAGE_VERSION=$(cat $PACKAGE_ROOT/DESCRIPTION | \
                      grep '^Version:' | sed 's/^.*: *//')

GIT_SHA=$(git -C "$PACKAGE_ROOT" rev-parse --short=7 HEAD)

if [[ -v "BRANCH_NAME" ]]; then
    GIT_BRANCH=${BRANCH_NAME}
else
    GIT_BRANCH=$(git symbolic-ref --short HEAD)
fi

TAG_SHA="${REGISTRY}/${PACKAGE_ORG}/${PACKAGE_NAME}:${GIT_SHA}"
TAG_BRANCH="${REGISTRY}/${PACKAGE_ORG}/${PACKAGE_NAME}:${GIT_BRANCH}"
TAG_LATEST="${REGISTRY}/${PACKAGE_ORG}/${PACKAGE_NAME}:latest"
TAG_VERSION="${REGISTRY}/${PACKAGE_ORG}/${PACKAGE_NAME}:v${PACKAGE_VERSION}"

NAME_NETWORK=daedalus
NAME_VOLUME=daedalus-results-volume
NAME_SERVER=daedalus-api
NAME_WORKER=daedalus-api-worker
NAME_REDIS=daedalus-redis
